{
  "name": "tongpin-sync-cinema",
  "version": "1.0.0",
  "private": true,
  "description": "同频观影 · 为异地情侣打造的私人同步放映室",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:protocol": "node tools/test-protocol.js",
    "test:features": "node tools/test-features.js",
    "test:resolve": "node tools/test-resolve.js",
    "test:growth": "node tools/test-growth.js",
    "test:reply": "node tools/test-reply.js",
    "test:seo": "node tools/test-seo.js",
    "gen:covers": "node tools/gen-covers.js",
    "test:e2e": "node tools/e2e.js",
    "sample": "node tools/make-sample.js",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:build:android": "cap sync android && cd android && gradlew.bat assembleDebug",
    "gen:app-icons": "node tools/gen-app-icons.js && cap sync",
    "icons": "node tools/gen-app-icons.js && capacitor-assets generate --iconBackgroundColor \"#0b0a09\" --iconBackgroundColorDark \"#0b0a09\" --splashBackgroundColor \"#0b0a09\" --splashBackgroundColorDark \"#0b0a09\" && node tools/patch-adaptive-icon.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "playwright-core": "^1.65.0"
  }
}
